# This home's settings. Copy to .env (git-ignored) and fill in.
# scripts/build.sh writes the app's part into app/js/env.js (also git-ignored).
# A blank value turns off what needs it.

# ---- in the app ------------------------------------------------------------
# Weather. Find coordinates with
# https://geocoding-api.open-meteo.com/v1/search?name=YOUR+TOWN
LATITUDE=
LONGITUDE=

# Home Assistant: its address and a long-lived access token
# (HA profile > Security > Long-lived access tokens).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Home Assistant entities particular to this home.
INSIDE_TEMPERATURE=sensor.inside_temperature
INSIDE_HUMIDITY=sensor.inside_humidity
POWER_SHUTOFF=sensor.psps
LAUNCHES=sensor.rocket_launches

# ---- docs and tools only (not put in the app) ------------------------------
# TV_IP and DUID live in scripts/tizen-env.sh.
TV_MAC=
DEV_HOST_IP=           # this computer, for the TV's Developer Mode
GATEWAY_IP=
PI_IP=                 # Home Assistant and Pi-hole
PI_SSH=user@raspberrypi.local
PI_WWW=/home/user/homeassistant/www
